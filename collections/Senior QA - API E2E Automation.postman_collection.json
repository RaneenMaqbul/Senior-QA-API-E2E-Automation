    {
      "name": "05 - Get Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Returned order id matches orderId\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql(pm.environment.get(\"orderId\"));",
              "});",
              "",
              "pm.test(\"Response contains customerName\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"customerName\");",
              "});",
              "",
              "pm.test(\"customerName equals QA Tester\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.customerName).to.eql(\"QA Tester\");",
              "});",
              "",
              "pm.test(\"Response time is less than 2000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"Content-Type contains application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});"
            ]
          }
        }
      ],
