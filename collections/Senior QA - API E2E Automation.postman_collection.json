        "description": "Generated from cURL: curl -X POST \"{{baseUrl}}/api-clients\" -H \"Content-Type: application/json\" -d \"{\\n  \\\"clientName\\\": \\\"Postman QA Workshop\\\",\\n  \\\"clientEmail\\\": \\\"qa_{{$timestamp}}@example.com\\\"\\n}\""
      },
      "response": []
